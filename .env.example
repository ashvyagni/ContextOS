# ContextOS Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL connection string
DATABASE_URL=postgresql://localhost:5432/contextos

# ContextOS Backend
CONTEXTOS_BACKEND_PORT=8000

# Banking Reference App
BANKING_BACKEND_PORT=8001
BANKING_FRONTEND_PORT=5174

# E-commerce Reference App
ECOMMERCE_BACKEND_PORT=8002
ECOMMERCE_FRONTEND_PORT=5175
